# Neon Postgres (console.neon.tech -> Connect). Pooled string (host contains "-pooler") for the app:
DATABASE_URL=
# Direct (non-pooled) string, used by prisma db push / migrations:
DIRECT_URL=
# Signs admin sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Customer sign-in (Better Auth). Falls back to ADMIN_SESSION_SECRET when unset.
BETTER_AUTH_SECRET=
# Public site address, e.g. https://your-site.netlify.app (Netlify sets URL automatically)
BETTER_AUTH_URL=
# Google sign-in: create an OAuth client at console.cloud.google.com
# Authorised redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notification delivery (disabled on GOODWILL_WORKFLOW_TEST=1; private test mailbox is used instead)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Test payments only. Live keys are deliberately rejected by this workflow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Encrypted backup mirror: separate disk or mounted backup destination.
# Keep the encryption key outside the server as well, otherwise encrypted backups cannot be recovered.
GOODWILL_BACKUP_MIRROR_DIR=
# 32 random bytes encoded as 64 hexadecimal characters
GOODWILL_BACKUP_ENCRYPTION_KEY=
